APP_NAME=GOLD COMMAND AI
ENVIRONMENT=dev
TIMEZONE=Europe/Sofia
DAILY_REPORT_HOUR=7
DAILY_REPORT_MINUTE=30
UPDATE_START_HOUR=8
UPDATE_END_HOUR=22
UPDATE_MINUTE=30

# Price provider
PRICE_PROVIDER=auto
PRICE_REQUEST_TIMEOUT_SEC=5.0
TWELVEDATA_API_KEY=
